{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Games workflow definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "description", "steps"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/definitions/id" },
    "description": { "$ref": "#/definitions/text" },
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "role", "adapter", "objective", "depends_on", "write_scope"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "role": { "$ref": "#/definitions/id" },
          "adapter": { "anyOf": [{ "$ref": "#/definitions/id" }, { "type": "null" }] },
          "objective": { "$ref": "#/definitions/text" },
          "depends_on": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
          "write_scope": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/text" } }
        }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S" }
  }
}
