{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Games hub catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "roles", "skills", "contracts"],
  "properties": {
    "schema_version": { "const": 1 },
    "roles": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/entry" } },
    "skills": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/entry" } },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "handoff"],
      "properties": {
        "task": { "$ref": "#/definitions/contract" },
        "handoff": { "$ref": "#/definitions/contract" }
      }
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file"],
      "properties": {
        "id": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "file": { "type": "string", "minLength": 1 }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "template"],
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "template": { "type": "string", "minLength": 1 }
      }
    }
  }
}
