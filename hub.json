    { "id": "course-lab", "file": "skills/course-lab/SKILL.md" }
  ],
  "guardrails": [
    { "id": "workspace-scope", "file": "guardrails/workspace-scope.md" },
    { "id": "human-review", "file": "guardrails/human-review.md" },
    { "id": "readable-code", "file": "guardrails/readable-code.md" },
    { "id": "asset-quality", "file": "guardrails/asset-quality.md" },
    { "id": "learning-integrity", "file": "guardrails/learning-integrity.md" },
    { "id": "netcode-performance", "file": "guardrails/netcode-performance.md" }
  ],
  "workflows": [
    { "id": "game-feature", "file": "workflows/game-feature.json" }
  ],
  "mcp_servers": [
    {
      "id": "games-memory",
      "description": "Ricerca, lettura e stato della memoria condivisa del hub e del checkout selezionato",
      "transport": "stdio",
      "runtime": "node",
      "entrypoint": "mcp/memory/server.mjs",
      "args": ["--hub-root", { "root": "hub" }],
      "project_args": ["--project-root", { "root": "project" }],
      "env": { "MISE_AUTO_INSTALL": "false" }
    }
  ],
  "contracts": {
    "task": {
      "schema": "schemas/task.schema.json",
      "template": "templates/task/task.json"
    },
    "handoff": {
      "schema": "schemas/handoff.schema.json",
      "template": "templates/task/handoff.json"
    }
  }
}
