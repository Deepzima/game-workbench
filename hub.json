    { "id": "games-architect", "client": "vscode", "role": "software-architect", "file": ".github/agents/games-architect.agent.md" },
    { "id": "games-graphics", "client": "vscode", "role": "technical-artist", "file": ".github/agents/games-graphics.agent.md" },
    { "id": "games-programmer", "client": "vscode", "role": "gameplay-programmer", "file": ".github/agents/games-programmer.agent.md" },
    { "id": "games-qa", "client": "vscode", "role": "qa-engineer", "file": ".github/agents/games-qa.agent.md" },
    { "id": "games-reviewer", "client": "vscode", "role": "independent-reviewer", "file": ".github/agents/games-reviewer.agent.md" }
  ],
  "skills": [
    { "id": "task-handoff", "file": "skills/task-handoff/SKILL.md" },
    { "id": "game-feature", "file": "skills/game-feature/SKILL.md" },
    { "id": "agent-guardrails", "file": "skills/agent-guardrails/SKILL.md" },
    { "id": "delegate-code", "file": "skills/delegate-code/SKILL.md" },
